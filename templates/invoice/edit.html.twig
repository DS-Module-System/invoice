{% extends 'base.html.twig' %}

{% macro btns(back_path_route, form, is_visible_delete_btn = false, params = {}, is_return_to_module_list = false, row) %}
    <div class="row border-top border-bottom mt-2 pt-2 pb-2">
        <div class="col-6"><a href="{{ path(back_path_route, params) }}" class="btn btn-light ds-cms-back-btn" {{ is_return_to_module_list == true ? 'data-return-to-module-list=""' : '' }}>
                <i class="mdi mdi-arrow-left-bold me-1"></i>{{ 'core.module.backBtnTitle'|dtrans }}</a>
        </div>
        <div class="col-6 text-end">
            {% if is_visible_delete_btn %}
                <button type="button" class="btn btn-danger me-md-2 mb-3 mb-md-0" data-bs-toggle="modal" data-bs-target="#danger-header-modal"><i class="mdi mdi-delete me-1"></i>{{'core.layout.deleteBtnTitle'|dtrans}}</button>
            {% endif %}

            <button type="button" class="btn btn-success me-md-2 mb-3 mb-md-0" data-bs-toggle="modal" data-bs-target="#save-header-modal"><i class="mdi mdi-delete me-1"></i>{{'core.layout.saveBtnTitle'|dtrans}}</button>

            <div id="save-header-modal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="save-header-modalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header modal-colored-header bg-success">
                            <h4 class="modal-title" id="danger-header-modalLabel">{{'core.table.confirmation.save'|dtrans}}</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                        </div>
                        <div class="modal-body text-start">
                            {{'core.table.confirmation.save.message'|dtrans}}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{'core.table.stopBtn'|dtrans}}</button>
                            {{ form_widget(form.save) }}
                            {#                                <button type="button" class="btn btn-danger">{{'core.table.delete'|dtrans}}</button>#}
                        </div>
                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->


            {% if is_visible_delete_btn %}
                <div id="danger-header-modal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="danger-header-modalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header modal-colored-header bg-danger">
                                <h4 class="modal-title" id="danger-header-modalLabel">{{'core.table.confirmation.deletion'|dtrans}}</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                            </div>
                            <div class="modal-body text-start">
                                {{'core.table.confirmation.deletion.message'|dtrans}}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{'core.table.stopBtn'|dtrans}}</button>
                                {{ form_widget(form.delete) }}
                                {#                                <button type="button" class="btn btn-danger">{{'core.table.delete'|dtrans}}</button>#}
                            </div>
                        </div><!-- /.modal-content -->
                    </div><!-- /.modal-dialog -->
                </div><!-- /.modal -->
            {% endif %}

            <button type="button" class="btn btn-info me-md-2 mb-3 mb-md-0" data-bs-toggle="modal" data-bs-target="#invoice-bs-example-modal-sm-{{ row.id }}"><i class="mdi mdi-printer me-1"></i>Print</button>

        </div>
    </div>
{% endmacro %}

{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

{% set form_btns = _self.btns('invoice_list', form, true, {}, false, row) %}

{# {% block javascript %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_app_invoice') }}
{% endblock %}

{% block stylesheet_after %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_app_invoice') }}
{% endblock %}


    {{ encore_entry_script_tags('admin_app_api_form') }}
{% endblock %} #}

{% block body %}
    {% include 'invoice/_tabs.html.twig' %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form._token) }}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    {% if row.type is constant('App\\Enum\\Invoice\\InvoiceType::Invoice') %}
                        <h4 class="header-title">{{ 'invoice.editInvoiceTitle'|dtrans }}</h4>
                    {% elseif row.type is constant('App\\Enum\\Invoice\\InvoiceType::CreditInvoice') %}
                        <h4 class="header-title">{{ 'invoice.createCreditTitle'|dtrans }}</h4>
                    {% elseif row.type is constant('App\\Enum\\Invoice\\InvoiceType::DebitInvoice') %}
                        <h4 class="header-title">{{ 'invoice.createDebitTitle'|dtrans }}</h4>
                    {% endif %}

                    {{ form_btns }}
                        {% include 'invoice/form_fields.html.twig' with {"form": form, 'row': row} only %}
                    {{ form_btns }}
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form, {'render_rest': false}) }}
    <div class="modal fade" id="apiForm" tabindex="-1" role="dialog" aria-labelledby="apiFormLabel" aria-hidden="true"></div>

    <div class="modal fade text-start" id="invoice-bs-example-modal-sm-{{ row.id }}" tabindex="-1" role="dialog" aria-labelledby="mySmallModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="mySmallModalLabel">Print</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <form target="_blank" method="post" action="{{ path('invoice_download', {'download': 1, "id": row.id}) }}">
                    <div class="modal-body">
                        
                        <div class="mt-2">
                            <div>{{ 'invoice.typeDocument'|dtrans }}</div>
                            <div> 
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" name="isOriginal" class="form-check-input" id="isOriginal-{{ row.id }}">
                                        <label class="form-check-label" for="isOriginal-{{ row.id }}">{{ 'invoice.original'|dtrans }}</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" name="isCopy" class="form-check-input" id="isCopy-{{ row.id }}">
                                        <label class="form-check-label" for="isCopy-{{ row.id }}">{{ 'invoice.copy'|dtrans }}</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'invoice.close'|dtrans }}</button>
                        <button type="submit" class="btn btn-primary"  data-bs-dismiss="modal">{{ 'invoice.print'|dtrans }}</button>
                    </div>
                </form>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
{% endblock %}

{% extends 'base.html.twig' %}

{% import 'core/default_templates/data_table_macro.html.twig' as data_table %}

{% block body %}
    <div class="row mb-2 pt-2 pb-2">
        <div class="col-12">
            <a href="{{ path('invoice_list') }}" class="btn btn-light ds-cms-back-btn" data-return-to-module-list>
                <i class="mdi mdi-arrow-left-bold me-1"></i>{{ 'core.module.backBtnTitle'|dtrans }}
            </a>
        </div>
    </div>
    {% include 'invoice/_tabs.html.twig' %}

    {% if invoice %}
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form) }}
                        {{ form_row(form._token) }}
                        <div class="form-group mb-2">
                            <div class="row">
                                <div>
                                    {{ form_label(form.receivers) }}
                                </div>
                                <div class="ms-2">
                                    {% for receiver in form.receivers %}
                                        <div class="mt-1">
                                            {{ form_widget(receiver) }}
                                            {{ form_label(receiver) }}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="invalid-feedback d-block">{{ form_errors(form.receivers) }}</div>
                        </div>
                        <div class="mb-2">
                            <a href="{{ path('client_address_create', {'clientId': invoice.client.id, 'backToInvoice': invoice.id}) }}" class="btn btn-primary btn-sm">Добави получател</a> 
                        </div>
                        <div class="form-group mb-2">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title) }}
                            <div class="invalid-feedback d-block">{{ form_errors(form.title) }}</div>
                        </div>
                        <div class="form-group mb-2">
                            {{ form_label(form.content) }}
                            {{ form_widget(form.content) }}
                            <div class="invalid-feedback d-block">{{ form_errors(form.content) }}</div>
                        </div>
                        <div class="form-group mb-2">
                            <button type="submit" class="btn btn-primary me-md-2 mb-3 mb-md-0"
                                    name="client_invoice_email_log_form[save]"
                                    value="1">
                                <i class="ri-mail-add-line"></i>
                                {{ 'invoice.sendEmailBtn'|dtrans }}
                            </button>
                            <button type="submit" class="btn btn-danger me-md-2 mb-3 mb-md-0" name="cancelEmail"
                                    value="1">
                                <i class="ri-mail-forbid-line"></i>
                                {{ 'invoice.cancelEmailBtn'|dtrans }}
                            </button>
                        </div>
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}